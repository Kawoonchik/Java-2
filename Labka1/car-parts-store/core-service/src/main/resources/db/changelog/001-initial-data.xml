<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-cards-table" author="course">
        <createTable tableName="cards">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="term" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="translation" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="example_sentence" type="TEXT"/>
            <column name="language" type="VARCHAR(10)"/>
        </createTable>
    </changeSet>

    <changeSet id="002-create-decks-table" author="course">
        <createTable tableName="decks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="customer_username" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-create-deck-cards-table" author="course">
        <createTable tableName="deck_cards">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="deck_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="card_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="deck_cards"
                baseColumnNames="deck_id"
                constraintName="fk_deck_cards_deck"
                referencedTableName="decks"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="deck_cards"
                baseColumnNames="card_id"
                constraintName="fk_deck_cards_card"
                referencedTableName="cards"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
